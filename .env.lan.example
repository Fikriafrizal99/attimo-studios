# LAN development deployment
# Use this only for internal/home-network testing. It is not staging or production.
APP_ENV=development
APP_ENV_FILE=.env.lan

# Docker host settings
APP_BIND=0.0.0.0
APP_PORT=3000

# LAN HTTP testing is intentionally non-strict.
P0_PREFLIGHT_STRICT=false
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false

# Supabase development credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_development_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_development_service_role_key

# Better Auth / PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://192.168.1.50:3000
NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000

# Public invitation routing
PUBLIC_INVITATION_BASE_URL=http://192.168.1.50:3000
PUBLIC_INVITATION_MODE=path

# Admin-managed V1
ALLOW_PUBLIC_SIGNUP=false

# Public submission protection
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
