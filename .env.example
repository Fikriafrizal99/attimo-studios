# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for all server-side commerce routes. Never expose this value to clients.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public invitation routing
# V1 baseline uses path mode: https://domain.id/invite/{slug}
PUBLIC_INVITATION_BASE_URL=http://localhost:3000
PUBLIC_INVITATION_MODE=path

# Admin-managed V1: public sign-up is blocked by middleware unless explicitly enabled.
ALLOW_PUBLIC_SIGNUP=false

# Public RSVP / wishes baseline protection (per runtime instance).
# For horizontally scaled production, replace this with Redis/Upstash or edge-provider rate limiting.
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
