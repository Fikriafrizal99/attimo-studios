# Environment identity
# Local development only. Next.js sets NODE_ENV=development automatically for `next dev`.
APP_ENV=development

# Supabase
# Prefer a dedicated development project. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_dev_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key

# Better Auth / PostgreSQL
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public invitation routing
# V1 baseline uses path mode: http://localhost:3000/invite/{slug}
PUBLIC_INVITATION_BASE_URL=http://localhost:3000
PUBLIC_INVITATION_MODE=path

# Admin-managed V1
ALLOW_PUBLIC_SIGNUP=false

# Public RSVP / wishes baseline protection (per runtime instance).
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000

# Preflight is intentionally relaxed for local HTTP development.
P0_PREFLIGHT_STRICT=false
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false
