# ENDRIYA isolated staging deployment
# Copy this file to .env.staging on the server. Never commit the populated runtime file.
# Next.js still runs with NODE_ENV=production; APP_ENV distinguishes staging from production.
APP_ENV=staging
APP_ENV_FILE=.env.staging

# Staging must coexist with the main deployment on the same Docker host.
# The dedicated Compose project is supplied by scripts/deploy-staging.sh.
APP_IMAGE=endriya-wedding:staging
APP_BIND=127.0.0.1
APP_PORT=3100

# Staging behaves like a public deployment: strict preflight, HTTPS, no public signup.
P0_PREFLIGHT_STRICT=true
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false

# Supabase staging project (public values only).
NEXT_PUBLIC_SUPABASE_URL=https://itgpywqrbvgsrjtibdle.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZW7gwk2IMv9U0DX6trH6ZQ_Ru-C5HS3

# Private runtime credentials. Fill these only in .env.staging on the server.
SUPABASE_SERVICE_ROLE_KEY=replace_with_staging_service_role_key
DATABASE_URL=postgresql://staging_user:replace_with_password@staging_database_host:5432/postgres
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Replace this host with the actual HTTPS staging hostname routed to 127.0.0.1:3100.
BETTER_AUTH_URL=https://staging.example.com
NEXT_PUBLIC_APP_URL=https://staging.example.com
PUBLIC_INVITATION_BASE_URL=https://staging.example.com
PUBLIC_INVITATION_MODE=path

# Admin-managed V1
ALLOW_PUBLIC_SIGNUP=false

# Public RSVP / wishes shared database-backed protection.
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
PUBLIC_WEDDING_BURST_RATE_LIMIT=300
PUBLIC_RESOLUTION_RATE_LIMIT=60
PUBLIC_READ_RATE_LIMIT=180
