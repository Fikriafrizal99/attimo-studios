# Staging deployment environment
# Next.js should still run with NODE_ENV=production; APP_ENV distinguishes staging from production.
APP_ENV=staging
APP_ENV_FILE=.env.staging

# Docker host settings
APP_BIND=0.0.0.0
APP_PORT=3000

# Staging should behave like a public deployment: HTTPS, strict preflight, no public signup.
P0_PREFLIGHT_STRICT=true
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false

# Supabase
# Use a dedicated staging project/database. Do not reuse production credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key

# Better Auth / PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=https://staging.example.com
NEXT_PUBLIC_APP_URL=https://staging.example.com

# Public invitation routing
PUBLIC_INVITATION_BASE_URL=https://staging.example.com
PUBLIC_INVITATION_MODE=path

# Admin-managed V1
ALLOW_PUBLIC_SIGNUP=false

# Public submission protection
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
