# Docker host / LAN settings
APP_BIND=0.0.0.0
APP_PORT=3000

# Keep strict=false while testing only on LAN over HTTP.
# Change to true after HTTPS/domain is configured.
P0_PREFLIGHT_STRICT=false
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Better Auth / PostgreSQL
# Prefer a Supabase pooler connection if the direct database endpoint is not
# reachable from your home network.
DATABASE_URL=postgresql://user:password@host:5432/postgres
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# LAN phase example: replace 192.168.1.50 with your server LAN IP.
BETTER_AUTH_URL=http://192.168.1.50:3000
NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000
PUBLIC_INVITATION_BASE_URL=http://192.168.1.50:3000
PUBLIC_INVITATION_MODE=path

# V1 is admin-managed.
ALLOW_PUBLIC_SIGNUP=false

# Public submission protection. This limiter is per app instance.
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
