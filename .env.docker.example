# Production / self-host deployment environment
APP_ENV=production
APP_ENV_FILE=.env.production

# Docker host settings
APP_BIND=0.0.0.0
APP_PORT=3000

# Production must pass strict preflight.
P0_PREFLIGHT_STRICT=true
P0_PREFLIGHT_ALLOW_PLACEHOLDERS=false

# Supabase
# Use production-only credentials. Never reuse development or staging service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# Better Auth / PostgreSQL
# Prefer a production pooler connection when appropriate for the hosting topology.
DATABASE_URL=postgresql://user:password@host:5432/postgres
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_APP_URL=https://example.com

# Public invitation routing
PUBLIC_INVITATION_BASE_URL=https://example.com
PUBLIC_INVITATION_MODE=path

# V1 is admin-managed.
ALLOW_PUBLIC_SIGNUP=false

# Public submission protection. This limiter is per app instance.
PUBLIC_SUBMISSION_RATE_LIMIT=10
PUBLIC_SUBMISSION_RATE_WINDOW_MS=600000
